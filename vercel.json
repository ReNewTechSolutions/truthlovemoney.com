{
  "buildCommand": "npm run build",
  "devCommand": "vite --port $PORT",
  "installCommand": "npm install",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/blog",
      "destination": "/stories",
      "permanent": true
    },
    {
      "source": "/blog/:slug",
      "destination": "/stories/:slug",
      "permanent": true
    }
  ]
}
